
<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>MINO RPG ADVENTURE</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#101820;color:white;
 font-family:Arial,sans-serif;overflow:hidden;
}
#game{
 display:block;width:100vw;height:100dvh;
 background:#254c35;touch-action:none;
}
#hud{
 position:absolute;top:12px;left:12px;right:12px;
 display:flex;justify-content:space-between;gap:8px;
 pointer-events:none;
}
.panel{
 background:#101820df;border:1px solid #d5a94c;
 border-radius:12px;padding:10px;font-size:13px;
 box-shadow:0 4px 15px #0007;
}
.bar{height:9px;background:#444;border-radius:9px;margin-top:5px;overflow:hidden}
.fill{height:100%;width:100%;background:#e34b4b}
#xp{background:#e9b83e}
#message{
 position:absolute;bottom:125px;left:50%;
 transform:translateX(-50%);
 background:#101820e8;border:1px solid #d5a94c;
 padding:10px 16px;border-radius:12px;
 text-align:center;max-width:90%;font-size:13px;
}
#controls{
 position:absolute;bottom:18px;left:15px;right:15px;
 display:flex;justify-content:space-between;align-items:end;
}
.pad{display:grid;grid-template-columns:48px 48px 48px;gap:5px}
.actions{display:flex;gap:9px;align-items:end}
button{
 border:1px solid #d5a94c;background:#172631;color:white;
 border-radius:13px;font-weight:bold;
 min-width:48px;height:48px;font-size:17px;
 touch-action:none;
}
button:active{background:#a87525}
.action{width:58px;height:58px;border-radius:50%;font-size:12px}
#title{
 position:absolute;top:80px;left:50%;transform:translateX(-50%);
 color:#f3d17a;font-weight:bold;letter-spacing:3px;
 text-shadow:0 3px 5px black;font-size:19px;
 pointer-events:none;white-space:nowrap;
}
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="hud">
 <div class="panel">
  <b>⚔ MINO</b> · المستوى <span id="level">1</span>
  <div class="bar"><div class="fill" id="health"></div></div>
  <small>❤️ <span id="hp">100</span>/100</small>
  <div class="bar"><div class="fill" id="xp" style="width:0%"></div></div>
  <small>⭐ XP: <span id="experience">0</span>/100</small>
 </div>
 <div class="panel">
  🪙 <span id="gold">30</span><br>
  <small>🌲 غابة الظلال</small>
 </div>
</div>

<div id="title">MINO RPG ADVENTURE</div>
<div id="message">استكشف العالم، اهزم الوحوش واجمع الذهب!</div>

<div id="controls">
 <div class="pad">
  <span></span><button data-key="ArrowUp">▲</button><span></span>
  <button data-key="ArrowLeft">◀</button>
  <button data-key="ArrowDown">▼</button>
  <button data-key="ArrowRight">▶</button>
 </div>
 <div class="actions">
  <button class="action" id="heal">💚<br>شفاء</button>
  <button class="action" id="attack">⚔<br>هجوم</button>
 </div>
</div>

<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");
let W,H;
function resize(){
 W=canvas.width=innerWidth*devicePixelRatio;
 H=canvas.height=innerHeight*devicePixelRatio;
 ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
 W=innerWidth;H=innerHeight;
}
resize();addEventListener("resize",resize);

const saved=JSON.parse(localStorage.getItem("minoSave")||"null");
const player={
 x:saved?.x??500,y:saved?.y??450,
 hp:saved?.hp??100,maxHp:100,
 level:saved?.level??1,
 xp:saved?.xp??0,gold:saved?.gold??30,
 attack:25
};
let keys={};
let message="استكشف العالم، اهزم الوحوش واجمع الذهب!";
let messageTime=0;

const enemies=[
 {x:720,y:430,hp:50,max:50,name:"Slime",color:"#80e65a",alive:true},
 {x:900,y:650,hp:75,max:75,name:"Goblin",color:"#b9a34b",alive:true},
 {x:350,y:850,hp:120,max:120,name:"Dark Knight",color:"#9c73d7",alive:true},
 {x:1200,y:950,hp:200,max:200,name:"Shadow Lord",color:"#e34b4b",alive:true}
];

const trees=[];
for(let i=0;i<65;i++){
 trees.push({x:Math.random()*1800,y:Math.random()*1400});
}
const houses=[
 {x:220,y:220,w:115,h:90},
 {x:410,y:240,w:110,h:85},
 {x:300,y:390,w:130,h:90}
];

function say(t){
 message=t;messageTime=220;
 document.getElementById("message").textContent=t;
}
function save(){
 localStorage.setItem("minoSave",JSON.stringify({
 ...player
 }));
}
function updateHUD(){
 document.getElementById("hp").textContent=player.hp;
 document.getElementById("level").textContent=player.level;
 document.getElementById("gold").textContent=player.gold;
 document.getElementById("experience").textContent=player.xp;
 document.getElementById("health").style.width=(player.hp/player.maxHp*100)+"%";
 document.getElementById("xp").style.width=player.xp+"%";
}
function drawWorld(camX,camY){
 ctx.fillStyle="#315f3b";ctx.fillRect(0,0,W,H);

 // العشب
 for(let x=0;x<1900;x+=80)
 for(let y=0;y<1500;y+=80){
  ctx.fillStyle=((x+y)/80)%2?"#356b40":"#386f42";
  ctx.fillRect(x-camX,y-camY,80,80);
 }
 // الطريق
 ctx.fillStyle="#a58b5b";
 ctx.fillRect(0-camX,285-camY,1500,65);
 ctx.fillRect(350-camX,0-camY,65,1200);
 // النهر
 ctx.fillStyle="#287fa0";
 ctx.fillRect(1050-camX,0-camY,95,1400);
 ctx.strokeStyle="#7bd3e9";ctx.lineWidth=3;
 for(let y=0;y<1400;y+=50){
  ctx.beginPath();ctx.moveTo(1060-camX,y-camY);
  ctx.lineTo(1130-camX,y+20-camY);ctx.stroke();
 }
 // الأشجار
 trees.forEach(t=>{
  ctx.fillStyle="#50391f";
  ctx.fillRect(t.x-camX-5,t.y-camY,10,24);
  ctx.fillStyle="#164b2b";
  ctx.beginPath();ctx.arc(t.x-camX,t.y-camY,22,0,Math.PI*2);ctx.fill();
  ctx.fillStyle="#287044";
  ctx.beginPath();ctx.arc(t.x-camX-8,t.y-camY-9,13,0,Math.PI*2);ctx.fill();
 });
 // المنازل
 houses.forEach(h=>{
  ctx.fillStyle="#c2a16b";
  ctx.fillRect(h.x-camX,h.y-camY,h.w,h.h);
  ctx.fillStyle="#75412c";
  ctx.beginPath();
  ctx.moveTo(h.x-camX-10,h.y-camY);
  ctx.lineTo(h.x-camX+h.w/2,h.y-camY-55);
  ctx.lineTo(h.x-camX+h.w+10,h.y-camY);
  ctx.fill();
  ctx.fillStyle="#51311e";
  ctx.fillRect(h.x-camX+45,h.y-camY+42,23,48);
 });
 // علامة القرية
 ctx.fillStyle="#f4d47b";
 ctx.font="bold 18px Arial";
 ctx.fillText("HERNAND VILLAGE",220-camX,180-camY);
}
function drawCharacter(x,y,color,label,camX,camY){
 ctx.fillStyle="#0006";
 ctx.beginPath();ctx.ellipse(x-camX,y-camY+14,15,7,0,0,Math.PI*2);ctx.fill();
 ctx.fillStyle=color;
 ctx.fillRect(x-camX-10,y-camY-12,20,27);
 ctx.fillStyle="#f0c79b";
 ctx.beginPath();ctx.arc(x-camX,y-camY-20,10,0,Math.PI*2);ctx.fill();
 ctx.fillStyle="#fff";
 ctx.font="11px Arial";ctx.textAlign="center";
 ctx.fillText(label,x-camX,y-camY-36);
 ctx.textAlign="left";
}
function draw(){
 const camX=Math.max(0,Math.min(1800-W,player.x-W/2));
 const camY=Math.max(0,Math.min(1400-H,player.y-H/2));
 drawWorld(camX,camY);
 enemies.forEach(e=>{
  if(!e.alive)return;
  drawCharacter(e.x,e.y,e.color,e.name,camX,camY);
  ctx.fillStyle="#222";ctx.fillRect(e.x-camX-17,e.y-camY-47,34,5);
  ctx.fillStyle="#e34b4b";ctx.fillRect(e.x-camX-17,e.y-camY-47,34*e.hp/e.max,5);
 });
 drawCharacter(player.x,player.y,"#e7b84b","MINO",camX,camY);
}
function move(){
 let dx=0,dy=0;
 if(keys.ArrowUp||keys.w)dy--;
 if(keys.ArrowDown||keys.s)dy++;
 if(keys.ArrowLeft||keys.a)dx--;
 if(keys.ArrowRight||keys.d)dx++;
 if(dx||dy){
  const length=Math.hypot(dx,dy);
  player.x+=dx/length*3;
  player.y+=dy/length*3;
 }
 player.x=Math.max(20,Math.min(1780,player.x));
 player.y=Math.max(20,Math.min(1380,player.y));
}
function attack(){
 let target=null,dist=Infinity;
 enemies.forEach(e=>{
  if(!e.alive)return;
  const d=Math.hypot(e.x-player.x,e.y-player.y);
  if(d<dist){dist=d;target=e;}
 });
 if(!target||dist>85){say("اقترب من الوحش أولاً!");return;}
 target.hp-=player.attack;
 if(target.hp<=0){
  target.alive=false;
  player.gold+=15;
  player.xp+=40;
  say("انتصرت! حصلت على 15 ذهباً و40 XP");
  if(player.xp>=100){
   player.xp-=100;player.level++;
   player.maxHp+=20;player.hp=player.maxHp;
   player.attack+=8;say("🎉 ارتقيت إلى المستوى "+player.level);
  }
 }else say("ضربة ناجحة! تبقى للعدو "+target.hp+" صحة");
 updateHUD();save();
}
function heal(){
 if(player.gold<10){say("تحتاج إلى 10 ذهب لشراء العلاج!");return;}
 player.gold-=10;
 player.hp=Math.min(player.maxHp,player.hp+35);
 say("استعدت 35 نقطة صحة");
 updateHUD();save();
}
document.getElementById("attack").onclick=attack;
document.getElementById("heal").onclick=heal;
document.addEventListener("keydown",e=>{keys[e.key]=true;if(e.key===" ")attack();});
document.addEventListener("keyup",e=>keys[e.key]=false);
document.querySelectorAll("[data-key]").forEach(b=>{
 const k=b.dataset.key;
 b.addEventListener("pointerdown",e=>{e.preventDefault();keys[k]=true;});
 ["pointerup","pointerleave","pointercancel"].forEach(ev=>
 b.addEventListener(ev,()=>keys[k]=false));
});
function loop(){
 move();draw();updateHUD();
 if(messageTime>0)messageTime--;
 save();
 requestAnimationFrame(loop);
}
updateHUD();loop();
</script>
</body>
</html>
